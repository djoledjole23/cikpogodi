# Kopiraj u .env.local i popuni. Na Vercelu iste vrednosti idu u Settings → Environment Variables.

# Adresa sajta (bez kose crte na kraju). Lokalno: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.cikpogodi.rs

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TVOJ-PROJEKAT.supabase.co
# „Publishable” ključ (ili stari „anon” ključ). Sme da bude javan.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# „Secret” ključ (ili stari „service_role” ključ). TAJNA: nikad u kod, nikad u NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Supabase → dugme Connect → „Transaction pooler”. U adresi zameni [YOUR-PASSWORD] šifrom baze. TAJNA.
# Bez ovoga `npm run dev` koristi bazu u memoriji (igra radi, nalozi ne).
DATABASE_URL=
